    <Param val="Thank you for your patience." valType="str" updates="None" name="End Message"/>
    <Param val="{'participant': 'f&quot;{randint(0, 999999):06.0f}&quot;', 'session': '001', 'language': '[&quot;English&quot;, &quot;French&quot;, &quot;Spanish&quot;, &quot;German&quot;]', 'response_mode': '[&quot;Both hands&quot;, &quot;Left hand&quot;, &quot;Right hand&quot;]', 'n_angles': '[&quot;6 (0°, 45°, 135°, 180°, 225°, 315°)&quot;, &quot;4 (increments of 90°)&quot;,\n &quot;6 (increments of 60°)&quot;, &quot;8 (increments of 45°)&quot;, &quot;12 (increments of 30°)&quot;]', 'body_views': '[&quot;Front and Back&quot;, &quot;Front&quot;, &quot;Back&quot;]', 'limbs': '[&quot;Arms and Legs&quot;, &quot;Arms&quot;, &quot;Legs&quot;]', 'n_reps': '[&quot;1&quot;, &quot;4&quot;, &quot;8&quot;, &quot;12&quot;]', 'feedback': '[&quot;0.3&quot;, &quot;0.5&quot;, &quot;0.8&quot;, &quot;1&quot;, &quot;No feedback in testblock(s)&quot;]'}" valType="code" updates="None" name="Experiment info"/>
    <Param val="True" valType="bool" updates="None" name="Force stereo"/>
