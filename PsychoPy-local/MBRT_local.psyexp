    <Routine name="exp_settings">
      <RoutineSettingsComponent name="exp_settings" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="exp_settings" valType="code" updates="None" name="name"/>
        <Param val="False" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="n_reps_settings" plugin="None">
        <Param val="### DISABLE EXPERIMENT SETTINGS ANS SET DEFAULT ###&amp;#10;# 1) set default here (&quot;1&quot;, &quot;4&quot;, &quot;8&quot;, &quot;12&quot;) and in the tab on the right&amp;#10;selected_n_reps = &quot;4&quot;&amp;#10;# 2) comment out line 2 in &quot;Begin experiment&quot; tab of this code component&amp;#10;# 3) Go to the &quot;Experiment settings&quot; and delte the &quot;Experiment info&quot; field for&amp;#10;#    the experiment setting that you want to be fixed" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="selected_n_reps = &quot;4&quot;; " valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# Get selected_n_reps from experiment info&amp;#10;selected_n_reps = expInfo['n_reps']&amp;#10;&amp;#10;# Add to output&amp;#10;thisExp.addData(&quot;selected_n_reps&quot;, selected_n_reps) &amp;#10;&amp;#10;# MBRT always includes one practice block&amp;#10;pract_block = 1&amp;#10;&amp;#10;# Test block structure&amp;#10;if selected_n_reps == '1':&amp;#10;    total_test_blocks = 1&amp;#10;    test_reps_per_block = 1&amp;#10;else:&amp;#10;    total_test_blocks = 4&amp;#10;    test_reps_per_block = int(selected_n_reps) // 4&amp;#10;&amp;#10;# One practice block plus the test blocks&amp;#10;total_blocks = 1 + total_test_blocks&amp;#10;&amp;#10;# Counters&amp;#10;block_number = 0&amp;#10;n_testbl = 0&amp;#10;n_trial = 0&amp;#10;phase = ''" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="// Get selected_n_reps from experiment info&amp;#10;selected_n_reps = expInfo[&quot;n_reps&quot;];&amp;#10;&amp;#10;// Add to output&amp;#10;psychoJS.experiment.addData(&quot;selected_n_reps&quot;, selected_n_reps);&amp;#10;&amp;#10;// MBRT always includes one practice block&amp;#10;pract_block = 1;&amp;#10;&amp;#10;// Test block structure&amp;#10;total_test_blocks;&amp;#10;test_reps_per_block;&amp;#10;&amp;#10;if (selected_n_reps === &quot;1&quot;) {&amp;#10;    total_test_blocks = 1;&amp;#10;    test_reps_per_block = 1;&amp;#10;} else {&amp;#10;    total_test_blocks = 4;&amp;#10;    test_reps_per_block = Number(selected_n_reps) / 4;&amp;#10;}&amp;#10;&amp;#10;// One practice block plus the test blocks&amp;#10;total_blocks = 1 + total_test_blocks;&amp;#10;&amp;#10;// Counters&amp;#10;block_number = 0;&amp;#10;n_testbl = 0;&amp;#10;n_trial = 0;&amp;#10;phase = &quot;&quot;;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="n_reps_settings" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="feedback_settings" plugin="None">
        <Param val="### DISABLE EXPERIMENT SETTINGS ANS SET DEFAULT ###&amp;#10;# 1) set default here (&quot;0.3&quot;, &quot;0.5&quot;, &quot;0.8&quot;, &quot;1&quot;, &quot;No feedback in testblock(s)&quot;)&amp;#10;#    and in the tab on the right&amp;#10;selected_feedback = &quot;No feedback in testblock(s)&quot;&amp;#10;# 2) comment out line 2 in &quot;Begin experiment&quot; tab of this code component&amp;#10;# 3) Go to the &quot;Experiment settings&quot; and delte the &quot;Experiment info&quot; field for&amp;#10;#    the experiment setting that you want to be fixed" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="selected_feedback = &quot;No feedback in testblock(s)&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# Get selected_feedback from experiment info&amp;#10;selected_feedback = expInfo['feedback']&amp;#10;&amp;#10;# Add to output&amp;#10;thisExp.addData(&quot;selected_feedback&quot;, selected_feedback) &amp;#10;&amp;#10;if selected_feedback == 'No feedback in testblock(s)':&amp;#10;    task_fb = False&amp;#10;    feedback_time = 0.0&amp;#10;else:&amp;#10;    task_fb = True&amp;#10;    feedback_time = float(selected_feedback)&amp;#10;&amp;#10;# Practice always has feedback.&amp;#10;# If test feedback is disabled, practice feedback lasts 1 s.&amp;#10;practice_feedback_time = feedback_time if task_fb else 1.0&amp;#10;&amp;#10;black = [-1, -1, -1]&amp;#10;green = [-1, 0, -1]&amp;#10;red = [0.5, -1, -1]" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="selected_feedback = expInfo[&quot;feedback&quot;];&amp;#10;psychoJS.experiment.addData(&quot;selected_feedback&quot;, selected_feedback);&amp;#10;if ((selected_feedback === &quot;No feedback in testblock(s)&quot;)) {&amp;#10;    task_fb = false;&amp;#10;    feedback_time = 0.0;&amp;#10;} else {&amp;#10;    task_fb = true;&amp;#10;    feedback_time = Number.parseFloat(selected_feedback);&amp;#10;}&amp;#10;practice_feedback_time = (task_fb ? feedback_time : 1.0);&amp;#10;black = [(- 1), (- 1), (- 1)];&amp;#10;green = [(- 1), 0, (- 1)];&amp;#10;red = [0.5, (- 1), (- 1)];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="feedback_settings" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="conditions_settings" plugin="None">
        <Param val="### DISABLE EXPERIMENT SETTINGS ANS SET DEFAULT ###&amp;#10;# 1) set defaults here and in the tab on the right&amp;#10;#  - n_angles: (&quot;6 (0°, 45°, 135°, 180°, 225°, 315°)&quot;, &quot;4 (increments of 90°)&quot;,&amp;#10;#    &quot;6 (increments of 60°)&quot;, &quot;8 (increments of 45°)&quot;, &quot;12 (increments of 30°)&quot;) &amp;#10;#  - limbs: (&quot;Arms and Legs&quot;, &quot;Arms&quot;, &quot;Legs&quot;)&amp;#10;#  - body_views: (&quot;Front and Back&quot;, &quot;Front&quot;, &quot;Back&quot;)&amp;#10;#  - response_mode: (&quot;Both hands&quot;, &quot;Left hand&quot;, &quot;Right hand&quot;)&amp;#10;selected_n_angles = &quot;6 (0°, 45°, 135°, 180°, 225°, 315°)&quot;&amp;#10;selected_limbs = &quot;Arms and Legs&quot;&amp;#10;selected_body_views = &quot;Front and Back&quot;&amp;#10;selected_response_mode = &quot;Both hands&quot;&amp;#10;&amp;#10;# 2) comment out lines 2-5 in &quot;Begin experiment&quot; tab of this code component&amp;#10;# 3) Go to the &quot;Experiment settings&quot; and delte the &quot;Experiment info&quot; field for&amp;#10;#    the experiment setting that you want to be fixed" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="selected_n_angles = &quot;6 (0\u00b0, 45\u00b0, 135\u00b0, 180\u00b0, 225\u00b0, 315\u00b0)&quot;;&amp;#10;selected_limbs = &quot;Arms and Legs&quot;;&amp;#10;selected_body_views = &quot;Front and Back&quot;;&amp;#10;selected_response_mode = &quot;Both hands&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# Get settings from experiment info&amp;#10;selected_n_angles = expInfo['n_angles']&amp;#10;selected_limbs = expInfo['limbs']&amp;#10;selected_body_views = expInfo['body_views']&amp;#10;selected_response_mode = expInfo['response_mode']&amp;#10;&amp;#10;# Add to output&amp;#10;thisExp.addData(&quot;selected_n_angles&quot;, selected_n_angles) &amp;#10;thisExp.addData(&quot;selected_limbs&quot;, selected_limbs) &amp;#10;thisExp.addData(&quot;selected_body_views&quot;, selected_body_views) &amp;#10;thisExp.addData(&quot;selected_response_mode&quot;, selected_response_mode) &amp;#10;&amp;#10;# Select corresponding conditions file&amp;#10;import pandas as pd&amp;#10;&amp;#10;conditions_map = {&amp;#10;    '6 (0°, 45°, 135°, 180°, 225°, 315°)': 'mbrt_files/Stimuli_6angles_def_all.xlsx',&amp;#10;    '4 (increments of 90°)': 'mbrt_files/Stimuli_4angles_all.xlsx',&amp;#10;    '6 (increments of 60°)': 'mbrt_files/Stimuli_6angles_all.xlsx',&amp;#10;    '8 (increments of 45°)': 'mbrt_files/Stimuli_8angles_all.xlsx',&amp;#10;    '12 (increments of 30°)': 'mbrt_files/Stimuli_12angles_all.xlsx'&amp;#10;}&amp;#10;&amp;#10;conditions_file = conditions_map[selected_n_angles]&amp;#10;&amp;#10;# Stimuli&amp;#10;test_df = pd.read_excel(conditions_file)&amp;#10;practice_df = pd.read_excel('mbrt_files/Stimuli_4angles_all.xlsx')&amp;#10;&amp;#10;if selected_body_views == 'Front':&amp;#10;    test_df = test_df[test_df['mbrt_view'] == 'front']&amp;#10;    practice_df = practice_df[practice_df['mbrt_view'] == 'front']&amp;#10;elif selected_body_views == 'Back':&amp;#10;    test_df = test_df[test_df['mbrt_view'] == 'back']&amp;#10;    practice_df = practice_df[practice_df['mbrt_view'] == 'back']&amp;#10;&amp;#10;if selected_limbs == 'Arms':&amp;#10;    test_df = test_df[test_df['mbrt_limb'] == 'arm']&amp;#10;    practice_df = practice_df[practice_df['mbrt_limb'] == 'arm']&amp;#10;elif selected_limbs == 'Legs':&amp;#10;    test_df = test_df[test_df['mbrt_limb'] == 'leg']&amp;#10;    practice_df = practice_df[practice_df['mbrt_limb'] == 'leg']&amp;#10;&amp;#10;test_df = test_df.reset_index(drop=True)&amp;#10;test_df['mbrt_images'] = 'mbrt_images/' + test_df['mbrt_images'].astype(str)&amp;#10;test_df.to_csv('Stimuli_last_run.csv', index=False)&amp;#10;&amp;#10;practice_df = practice_df[practice_df['mbrt_angle'] == 0].reset_index(drop=True)&amp;#10;practice_df['mbrt_images'] = 'mbrt_images/' + practice_df['mbrt_images'].astype(str)&amp;#10;practice_df.to_csv('Practice_last_run.csv', index=False)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as pd from 'pandas';&amp;#10;selected_n_angles = expInfo[&quot;n_angles&quot;];&amp;#10;selected_limbs = expInfo[&quot;limbs&quot;];&amp;#10;selected_body_views = expInfo[&quot;body_views&quot;];&amp;#10;selected_response_mode = expInfo[&quot;response_mode&quot;];&amp;#10;psychoJS.experiment.addData(&quot;selected_n_angles&quot;, selected_n_angles);&amp;#10;psychoJS.experiment.addData(&quot;selected_limbs&quot;, selected_limbs);&amp;#10;psychoJS.experiment.addData(&quot;selected_body_views&quot;, selected_body_views);&amp;#10;psychoJS.experiment.addData(&quot;selected_response_mode&quot;, selected_response_mode);&amp;#10;conditions_map = {&quot;6 (0\u00b0, 45\u00b0, 135\u00b0, 180\u00b0, 225\u00b0, 315\u00b0)&quot;: &quot;mbrt_files/Stimuli_6angles_def_all.xlsx&quot;, &quot;4 (increments of 90\u00b0)&quot;: &quot;mbrt_files/Stimuli_4angles_all.xlsx&quot;, &quot;6 (increments of 60\u00b0)&quot;: &quot;mbrt_files/Stimuli_6angles_all.xlsx&quot;, &quot;8 (increments of 45\u00b0)&quot;: &quot;mbrt_files/Stimuli_8angles_all.xlsx&quot;, &quot;12 (increments of 30\u00b0)&quot;: &quot;mbrt_files/Stimuli_12angles_all.xlsx&quot;};&amp;#10;conditions_file = conditions_map[selected_n_angles];&amp;#10;test_df = pd.read_excel(conditions_file);&amp;#10;practice_df = pd.read_excel(&quot;mbrt_files/Stimuli_4angles_all.xlsx&quot;);&amp;#10;if ((selected_body_views === &quot;Front&quot;)) {&amp;#10;    test_df = test_df[(test_df[&quot;mbrt_view&quot;] === &quot;front&quot;)];&amp;#10;    practice_df = practice_df[(practice_df[&quot;mbrt_view&quot;] === &quot;front&quot;)];&amp;#10;} else {&amp;#10;    if ((selected_body_views === &quot;Back&quot;)) {&amp;#10;        test_df = test_df[(test_df[&quot;mbrt_view&quot;] === &quot;back&quot;)];&amp;#10;        practice_df = practice_df[(practice_df[&quot;mbrt_view&quot;] === &quot;back&quot;)];&amp;#10;    }&amp;#10;}&amp;#10;if ((selected_limbs === &quot;Arms&quot;)) {&amp;#10;    test_df = test_df[(test_df[&quot;mbrt_limb&quot;] === &quot;arm&quot;)];&amp;#10;    practice_df = practice_df[(practice_df[&quot;mbrt_limb&quot;] === &quot;arm&quot;)];&amp;#10;} else {&amp;#10;    if ((selected_limbs === &quot;Legs&quot;)) {&amp;#10;        test_df = test_df[(test_df[&quot;mbrt_limb&quot;] === &quot;leg&quot;)];&amp;#10;        practice_df = practice_df[(practice_df[&quot;mbrt_limb&quot;] === &quot;leg&quot;)];&amp;#10;    }&amp;#10;}&amp;#10;test_df = test_df.reset_index({&quot;drop&quot;: true});&amp;#10;test_df[&quot;mbrt_images&quot;] = (&quot;mbrt_images/&quot; + test_df[&quot;mbrt_images&quot;].astype(str));&amp;#10;test_df.to_csv(&quot;Stimuli_last_run.csv&quot;, {&quot;index&quot;: false});&amp;#10;practice_df = practice_df[(practice_df[&quot;mbrt_angle&quot;] === 0)].reset_index({&quot;drop&quot;: true});&amp;#10;practice_df[&quot;mbrt_images&quot;] = (&quot;mbrt_images/&quot; + practice_df[&quot;mbrt_images&quot;].astype(str));&amp;#10;practice_df.to_csv(&quot;Practice_last_run.csv&quot;, {&quot;index&quot;: false});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
