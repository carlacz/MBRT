      <CodeComponent name="block_start_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="block_number = 0&amp;#10;fb = True&amp;#10;block_message = &quot;&quot;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="block_number = 0;&amp;#10;fb = true;&amp;#10;block_message = &quot;&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.window.mouseVisible = false;&amp;#10;block_number += 1;&amp;#10;psychoJS.experiment.addData(&quot;block_number&quot;, block_number);&amp;#10;no_feedback_message = &quot;&quot;;&amp;#10;if ((block_number === 1)) {&amp;#10;    block_message = start_pract_msg;&amp;#10;} else {&amp;#10;    if ((selected_n_reps === &quot;1&quot;)) {&amp;#10;        block_message = start_single_block_msg;&amp;#10;    } else {&amp;#10;        testblock_messages = {[2]: start_first_block_msg, [3]: start_second_block_msg, [4]: start_third_block_msg, [5]: start_fourth_block_msg};&amp;#10;        block_message = testblock_messages[block_number];&amp;#10;    }&amp;#10;}&amp;#10;if (((block_number &gt; 1) &amp;&amp; (! task_fb))) {&amp;#10;    no_feedback_message = no_fb_msg;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="win.mouseVisible = False&amp;#10;# start block at 1 and increase every iteration&amp;#10;block_number += 1&amp;#10;thisExp.addData(&quot;block_number&quot;, block_number)&amp;#10;&amp;#10;# set up block messages according to task progress&amp;#10;no_feedback_message = &quot;&quot;&amp;#10;&amp;#10;if block_number == 1:&amp;#10;    # Practice block&amp;#10;    block_message = start_pract_msg&amp;#10;&amp;#10;elif selected_n_reps == '1':&amp;#10;    # Single test block&amp;#10;    block_message = start_single_block_msg&amp;#10;&amp;#10;else:&amp;#10;    # four test blocks&amp;#10;    testblock_messages = {&amp;#10;        2: start_first_block_msg,&amp;#10;        3: start_second_block_msg,&amp;#10;        4: start_third_block_msg,&amp;#10;        5: start_fourth_block_msg&amp;#10;    }&amp;#10;&amp;#10;    block_message = testblock_messages[block_number]&amp;#10;&amp;#10;# For testblocks without feedback&amp;#10;if block_number &gt; 1 and not task_fb:&amp;#10;    no_feedback_message = no_fb_msg" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
