        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((block_number === 1)) {&amp;#10;    phase = &quot;MBRT_practice&quot;;&amp;#10;    trial_conditions = &quot;Practice_last_run.csv&quot;;&amp;#10;    reps_per_block = 1;&amp;#10;    n_trial = 0;&amp;#10;    n_testbl = 0;&amp;#10;    show_response_boxes = 1;&amp;#10;    current_feedback_time = practice_feedback_time;&amp;#10;} else {&amp;#10;    phase = &quot;MBRT_testblock&quot;;&amp;#10;    trial_conditions = &quot;Stimuli_last_run.csv&quot;;&amp;#10;    reps_per_block = test_reps_per_block;&amp;#10;    n_testbl = (block_number - 1);&amp;#10;    if ((block_number === 2)) {&amp;#10;        n_trial = 0;&amp;#10;    }&amp;#10;    if (task_fb) {&amp;#10;        show_response_boxes = 1;&amp;#10;        current_feedback_time = feedback_time;&amp;#10;    } else {&amp;#10;        show_response_boxes = 0;&amp;#10;        current_feedback_time = 0.0;&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;phase&quot;, phase);&amp;#10;psychoJS.experiment.addData(&quot;n_testbl&quot;, n_testbl);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if block_number == 1:&amp;#10;    # Practice block&amp;#10;    phase = 'MBRT_practice'&amp;#10;    trial_conditions = 'Practice_last_run.csv'&amp;#10;    reps_per_block = 1&amp;#10;    n_trial = 0&amp;#10;    n_testbl = 0&amp;#10;    show_response_boxes = 1&amp;#10;    current_feedback_time = practice_feedback_time&amp;#10;&amp;#10;else:&amp;#10;    # Test blocks&amp;#10;    phase = 'MBRT_testblock'&amp;#10;    trial_conditions = 'Stimuli_last_run.csv'&amp;#10;    reps_per_block = test_reps_per_block&amp;#10;    n_testbl = block_number - 1&amp;#10;&amp;#10;    if block_number == 2:&amp;#10;        n_trial = 0&amp;#10;&amp;#10;    if task_fb:&amp;#10;        show_response_boxes = 1&amp;#10;        current_feedback_time = feedback_time&amp;#10;    else:&amp;#10;        show_response_boxes = 0&amp;#10;        current_feedback_time = 0.0&amp;#10;&amp;#10;thisExp.addData('phase', phase)&amp;#10;thisExp.addData('n_testbl', n_testbl)" valType="extendedCode" updates="constant" name="End Routine"/>
