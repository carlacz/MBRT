      <CodeComponent name="block_end_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="block_end_message = &quot;&quot;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="block_end_message = &quot;&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((block_number === 1)) {&amp;#10;    block_end_message = end_pract_msg;&amp;#10;} else {&amp;#10;    if ((block_number === 2)) {&amp;#10;        block_end_message = end_first_block_msg;&amp;#10;    } else {&amp;#10;        if ((block_number === 3)) {&amp;#10;            block_end_message = end_second_block_msg;&amp;#10;        } else {&amp;#10;            if ((block_number === 4)) {&amp;#10;                block_end_message = end_third_block_msg;&amp;#10;            } else {&amp;#10;                if ((block_number === 5)) {&amp;#10;                    block_end_message = end_fourth_block_msg;&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if block_number == 1:&amp;#10;    block_end_message = end_pract_msg&amp;#10;&amp;#10;elif block_number == 2:&amp;#10;    block_end_message = end_first_block_msg&amp;#10;&amp;#10;elif block_number == 3:&amp;#10;    block_end_message = end_second_block_msg&amp;#10;&amp;#10;elif block_number == 4:&amp;#10;    block_end_message = end_third_block_msg&amp;#10;    &amp;#10;elif block_number == 5:&amp;#10;    block_end_message = end_fourth_block_msg" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
